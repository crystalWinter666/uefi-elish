[FD.SILICIUM_UEFI]
BaseAddress = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress
Size = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1
BlockSize = 0x1000
NumBlocks = $(FD_BLOCKS)

0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
FvNameGuid = B5A92E3C-AB92-4731-AC72-448CCDBAB0AC
BlockSize = 0x1000
NumBlocks = 0
FvAlignment = 8
ERASE_POLARITY = 1
MEMORY_MAPPED = TRUE
READ_ENABLED_CAP = TRUE
READ_STATUS = TRUE

APRIORI DXE {
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF Binaries/pipa/QcomPkg/Drivers/EnvDxe/EnvDxe.inf
